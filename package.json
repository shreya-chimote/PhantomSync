{
  "name": "phantomsync-ai",
  "version": "1.0.0",
  "description": "Offline-first notes application with intelligent sync and conflict resolution",
  "scripts": {
    "server": "npm.cmd --prefix server start",
    "server:dev": "npm.cmd --prefix server run dev",
    "client": "npm.cmd --prefix client run dev",
    "test": "npm.cmd --prefix server test",
    "build": "npm.cmd --prefix client run build",
    "install:all": "npm.cmd --prefix server install && npm.cmd --prefix client install"
  },
  "keywords": [
    "offline-first",
    "indexeddb",
    "mongodb",
    "react",
    "sync",
    "conflict-resolution",
    "optimistic-concurrency-control"
  ],
  "author": "",
  "license": "MIT"
}
