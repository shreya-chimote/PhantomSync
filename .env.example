# PhantomSync Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# If left as localhost and MongoDB is not running, the server will
# automatically start an in-memory database fallback for instant development.
MONGODB_URI=mongodb://localhost:27017/phantomsync

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Optional AI Configuration
# Options: 'built-in' (default rule-based 3-way merge, no key required), 'gemini', 'openai'
AI_PROVIDER=built-in
GEMINI_API_KEY=
OPENAI_API_KEY=
